# ── MSMP Server 环境变量配置（所有项均可通过 MSMP_ 前缀覆盖） ──

# 服务器
MSMP_SERVER_ADDR=:8080
MSMP_SERVER_MODE=release
# MSMP_SERVER_ADVERTISE_ADDR=http://10.0.0.1:8080
# MSMP_SERVER_MAX_REQUEST_BODY_BYTES=10485760

# 数据库（PostgreSQL）
MSMP_DB_DRIVER=postgres
MSMP_DB_DSN=host=127.0.0.1 user=msmp password=CHANGE_ME dbname=msmp port=5432 sslmode=disable TimeZone=Asia/Shanghai
MSMP_DB_MAX_OPEN_CONNS=25
MSMP_DB_MAX_IDLE_CONNS=10
MSMP_DB_CONN_MAX_LIFETIME=900

# JWT（生产环境必须修改！）
MSMP_JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
MSMP_JWT_EXPIREHOUR=24

# Agent
MSMP_AGENT_TRANSPORT=http
MSMP_AGENT_HEARTBEATSEC=30
MSMP_AGENT_METRICREPORTSEC=30
MSMP_AGENT_OFFLINEAFTERSEC=120

# 安全
# MSMP_SECURITY_CREDENTIALKEY=           # base64 编码的 32 字节 AES 密钥
# MSMP_SECURITY_ALLOWED_ORIGINS=         # 逗号分隔 CORS 白名单
# MSMP_SECURITY_IP_ALLOWLIST=            # 逗号分隔 IP/CIDR 白名单
MSMP_SECURITY_MAX_LOGIN_ATTEMPTS=5
MSMP_SECURITY_LOGIN_LOCKOUT_SEC=600

# 数据保留
MSMP_RETENTION_RAW_RETENTION_DAYS=90
MSMP_RETENTION_DOWNSAMPLE_AT_DAYS=7